{
  "name": "review-saas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:qr": "deno run tests/verify-qr-scan.ts",
    "test:ai-config": "deno run tests/verify-ai-config.ts",
    "test:knowledge": "deno run tests/verify-business-knowledge.ts",
    "test:reviews": "deno run tests/verify-review-management.ts",
    "test:menu": "deno run tests/verify-restaurant-menu.ts",
    "test:restaurant": "deno run tests/verify-restaurant-menu.ts",
    "test:games": "deno run tests/verify-restaurant-games.ts",
    "test:loyalty": "deno run tests/verify-restaurant-loyalty.ts",
    "test:staff": "deno run tests/verify-restaurant-staff-and-analytics.ts",
    "test:templates": "deno run tests/verify-restaurant-templates-and-orders.ts",
    "test:staff-roster": "deno run tests/verify-staff-roster-and-inventory.ts",
    "test:barber": "deno run --allow-read --allow-env tests/verify-barber-queue.ts",
    "test:barber-hybrid": "deno run --allow-read --allow-env tests/verify-barber-hybrid-and-revenue.ts",
    "test:gym": "deno run --allow-read --allow-env tests/verify-gym-membership.ts",
    "test:gym-attendance": "deno run --allow-read --allow-env tests/verify-gym-attendance-and-goals.ts",
    "test:hospitality": "deno run --allow-read --allow-env tests/verify-complete-hospitality-os.ts",
    "test:cafe": "deno run --allow-read --allow-env tests/verify-cafe-os.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.67.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsqr": "^1.4.0",
    "oxlint": "^1.89.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
